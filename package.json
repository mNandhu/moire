{
    "name": "moire-root",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "version": "0.1.0",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "concurrently": "^9.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7"
    },
    "scripts": {
        "build": "pnpm -C packages/frontend build",
        "version:check": "node scripts/version.mjs check",
        "version:set": "node scripts/version.mjs set",
        "dev:backend": "node scripts/uv-backend.mjs run uvicorn moire.main:app --reload --port 8000",
        "dev:frontend": "pnpm -C packages/frontend dev",
        "dev": "concurrently -c auto -n backend,frontend \"pnpm dev:backend\" \"pnpm dev:frontend\"",
        "perf": "node scripts/uv-backend.mjs run python tests/perf_benchmark.py",
        "e2e": "pnpm build && pnpm -C packages/e2e test",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "packages/backend/**/*.py": [
            "node scripts/uv-backend.mjs run ruff check",
            "node scripts/uv-backend.mjs run ruff format --check"
        ],
        "packages/e2e/servers/*.py": [
            "node scripts/uv-backend.mjs run ruff check",
            "node scripts/uv-backend.mjs run ruff format --check"
        ],
        "packages/frontend/src/**/*.{ts,tsx}": [
            "pnpm -C packages/frontend exec eslint"
        ]
    }
}