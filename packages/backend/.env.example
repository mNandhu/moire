# SQLite database file. Relative paths resolve against the repo root (not the
# process cwd), so this defaults to <repo>/data/moire.db.
SQLITE_PATH=./data/moire.db
# How long a blocked writer waits for SQLite's file lock before erroring (ms).
SQLITE_BUSY_TIMEOUT_MS=5000

# Thumbnail storage: local filesystem root for generated WebP thumbnails.
# Defaults to ./data/thumbs. Keep it on a persistent volume, outside library trees.
THUMB_ROOT=./data/thumbs

# Scanner tuning
SCANNER_MAX_WORKERS=0
SCAN_PROGRESS_UPDATE_MS=500
THUMB_MAX_SIZE=768  # Max pixels for longest edge of generated thumbnails

# Ops / safety
LOG_SLOW_REQUESTS_MS=1000
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RESCAN_PER_MINUTE=1

# Logging: console + rotating file (<LOG_DIR>/moire.log). Relative LOG_DIR
# resolves against the repo root.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./data/logs
