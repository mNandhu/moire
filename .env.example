# Moiré Docker Compose environment. Copy to .env and adjust as needed.
# (For running the backend natively, see packages/backend/.env.example.)

# Thumbnails: longest edge in px of generated WebP thumbnails.
THUMB_MAX_SIZE=1080

# Scanner: worker threads per scan (0 = auto from CPU cores), and how many
# libraries may scan at the same time.
SCANNER_MAX_WORKERS=0
SCANNER_MAX_CONCURRENT_SCANS=2

# Filesystem watcher for new/changed images, plus a periodic full rescan as a
# backstop (host bind mounts on Windows/macOS don't deliver change events).
WATCH_ENABLED_DEFAULT=true
WATCH_RECONCILE_INTERVAL_S=900

LOG_LEVEL=INFO
